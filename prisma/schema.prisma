generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  password           String
  hashedRefreshToken String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  bugReports         BugReport[]
  templates          Template[]
}

model BugReport {
  id            String   @id @default(uuid())
  title         String
  description   String
  steps         String
  expectedResult String
  actualResult  String
  severity      String   @default("medium")
  priority      String   @default("medium")
  environment   String
  tone          String   @default("formal")
  headerVariant Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Template {
  id          String   @id @default(uuid())
  name        String   // "visual", "functional", "performance"
  description String?
  defaultData Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}